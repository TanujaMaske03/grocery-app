####################################################
################## ORDER APIs ######################
####################################################

### Create Order

POST http://localhost:5000/api/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "products": [
        {
            "product": "6a5edcac376305f601b80df3",
            "quantity": 2,
            "price": 50
        }
    ],
    "totalAmount": 100,
    "address": "Ashta, Maharashtra",
    "paymentMethod": "COD"
}

### Get My Orders

GET http://localhost:5000/api/orders
Authorization: Bearer {{token}}

### Get Single Order

GET http://localhost:5000/api/orders/6a5f012efcb27c72da59ac1e
Authorization: Bearer {{token}}

### Update Order Status

PUT http://localhost:5000/api/orders/6a5f012efcb27c72da59ac1e
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "orderStatus":"Shipped"
}